# Template: a imagem nginx:alpine troca ${PUBLIC_HOST} pelo valor do ambiente
# ao subir e grava o resultado em /etc/nginx/conf.d/default.conf. Variáveis do
# próprio Nginx ($host, $request_uri...) não são tocadas. Contrato: infra.md.

# Log de acesso sem query string: o callback do OAuth chega com ?code&state, que não vão para
# log (auth.md §2.10). Só o que a Privacy Policy cita: IP, data e hora, endereço e navegador
log_format no_query '$remote_addr [$time_local] "$request_method $uri $server_protocol" '
                    '$status $body_bytes_sent "$http_user_agent"';

server {
    listen 80;
    server_name _;
    access_log /var/log/nginx/access.log no_query;

    # PUBLIC_HOST e não $host: $host perde a porta (infra.md, decisão 12)
    return 301 https://${PUBLIC_HOST}$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;
    # no server, e não no http: o nginx.conf da imagem já tem um access_log no http, e dois no
    # mesmo nível gravam os dois (o "main" grava a query). Aqui, este substitui o herdado
    access_log /var/log/nginx/access.log no_query;

    # mkcert de proxy/certs/ ou self-signed gerado pelo certs.sh (decisão 11)
    ssl_certificate     /etc/nginx/certs/cert.pem;
    ssl_certificate_key /etc/nginx/certs/key.pem;

    # redirect que o próprio Nginx gera (/grafana → /grafana/) só com o caminho: o absoluto usaria a
    # porta de dentro do container (443) e perderia a 8443 do PC da 42, como na decisão 12
    absolute_redirect off;

    client_max_body_size 3m; # acima dos 2 MiB do avatar: o 413 sai do backend, no envelope (infra.md §2.3)

    location / {
        proxy_pass http://frontend:80;
    }

    # avatares: o backend escreve no volume media, o Nginx lê direto (decisão 13). O arquivo veio de
    # um User: nosniff impede o navegador de tratá-lo como outra coisa. O nome muda a cada envio,
    # então o cache pode ser longo; arquivo que não existe é 404 aqui, e não o index.html do SPA
    location /media/ {
        alias /media/;
        add_header X-Content-Type-Options nosniff always;
        expires 30d;
    }

    # o avatar padrão vem da imagem do proxy, não do volume: nome fixo, cache curto
    location = /media/avatars/default.png {
        alias /usr/share/nginx/default-avatar.png;
        add_header X-Content-Type-Options nosniff always;
        expires 1h;
    }

    location /api/ {
        proxy_pass http://backend:8000;          # sem barra final: o backend vê /api/... (decisão 5)
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;   # substitui, não acrescenta: o uvicorn lê o 1º IP, que o cliente forjaria
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /ws/ {
        proxy_pass http://backend:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;   # substitui, não acrescenta: o uvicorn lê o 1º IP, que o cliente forjaria
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;                # sem isso o Nginx corta socket parado aos 60 s
        proxy_send_timeout 3600s;
    }

    # Grafana: o TLS termina aqui e o login é o do Grafana (F8.11). Sem barra final e sem reescrita:
    # o serve_from_sub_path faz o Grafana esperar o /grafana/ inteiro (decisão 10)
    location /grafana/ {
        proxy_pass http://grafana:3000;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # o Grafana Live é WebSocket: sem o upgrade, a página do Grafana enche o console de erro
    location /grafana/api/live/ {
        proxy_pass http://grafana:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
