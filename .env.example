# Template do .env (infra.md §2.5). Nada de comentário no fim da linha: o env_file do
# compose gravaria o comentário dentro do valor.

# ---------- Banco ----------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=transcendence
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---------- Backend ----------
APP_ENV=development
LOG_LEVEL=info
# 32 bytes ou mais; obrigatório com APP_ENV=production. Gere com:
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_TTL_S=900
REFRESH_TOKEN_TTL_S=604800
MEDIA_DIR=/media

# ---------- OAuth ----------
FT_CLIENT_ID=
FT_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Borda ----------
# nome-ou-ip[:porta], com a porta quando a HTTPS não é a 443
PUBLIC_HOST=
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

# ---------- Monitoring ----------
PROM_RETENTION_TIME=7d
PROM_RETENTION_SIZE=500MB
# admin do Grafana: obrigatórios, o compose não sobe sem os dois (infra.md, decisão 19)
GF_SECURITY_ADMIN_USER=
GF_SECURITY_ADMIN_PASSWORD=
GF_SERVER_SERVE_FROM_SUB_PATH=true
GF_USERS_ALLOW_SIGN_UP=false
GF_AUTH_ANONYMOUS_ENABLED=false
# o Grafana não faz requisição para fora: Gravatar, analytics, versão e notícias
GF_SECURITY_DISABLE_GRAVATAR=true
GF_ANALYTICS_REPORTING_ENABLED=false
GF_ANALYTICS_CHECK_FOR_UPDATES=false
GF_ANALYTICS_CHECK_FOR_PLUGIN_UPDATES=false
GF_NEWS_NEWS_FEED_ENABLED=false
